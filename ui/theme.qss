/* ==========================================================================
   Linux AI Assistant – Modern Obsidian / Pure Dark Theme
   Palette:
     #080808  – base canvas background (deep neutral black)
     #121212  – card / panel / input surface
     #141414  – toolbar button / dropdown surface
     #1c1c1c  – elevated hover surface
     #242424  – active / pressed / selection surface
     #262626  – hairline borders (1px)
     #1f1f1f  – subtle dividers / separator borders
     #383838  – hover borders
     #555555  – subtle muted timestamps & hints
     #9e9e9e  – secondary text
     #ededed  – high-contrast primary text
     #ffffff  – pure white emphasis
     #ededed  – primary action button surface (high contrast monochrome)
     #10b981  – emerald success / ready / approve accent
     #059669  – emerald hover
     #f59e0b  – amber warning accent
     #ef4444  – red danger / error accent
     #f87171  – soft red text
     #221415  – soft red button surface
   ========================================================================== */

/* ── Global ────────────────────────────────────────────────────────────── */

QWidget {
    background-color: #080808;
    color: #ededed;
    font-family: "Inter", "Segoe UI", "Ubuntu", -apple-system, sans-serif;
    font-size: 13px;
    border: none;
    outline: none;
}

QMainWindow, QDialog {
    background-color: #080808;
}

/* ── Scroll Areas ──────────────────────────────────────────────────────── */

QScrollArea {
    background-color: #080808;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: #080808;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 6px;
    margin: 0;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background-color: #242424;
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #383838;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 6px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal {
    background-color: #242424;
    border-radius: 3px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #383838;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── Labels ────────────────────────────────────────────────────────────── */

QLabel {
    background-color: transparent;
    color: #ededed;
}

QLabel#sectionHeader {
    color: #ededed;
    font-size: 14px;
    font-weight: 600;
}

QLabel#mutedLabel {
    color: #9e9e9e;
    font-size: 12px;
}

/* ── Input fields ──────────────────────────────────────────────────────── */

QLineEdit {
    background-color: #121212;
    color: #ededed;
    border: 1px solid #262626;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: #383838;
    selection-color: #ffffff;
}

QLineEdit:focus {
    border-color: #4a4a4a;
}

QLineEdit:disabled {
    background-color: #121212;
    color: #555555;
    border-color: #202020;
}

QPlainTextEdit, QTextEdit {
    background-color: #121212;
    color: #ededed;
    border: 1px solid #262626;
    border-radius: 6px;
    padding: 6px;
    selection-background-color: #383838;
    selection-color: #ffffff;
}

QPlainTextEdit:focus, QTextEdit:focus {
    border-color: #4a4a4a;
}

QPlainTextEdit[readOnly="true"], QTextEdit[readOnly="true"] {
    background-color: #0d0d0d;
    color: #9e9e9e;
    border-color: #202020;
}

/* ── Monospace command box ─────────────────────────────────────────────── */

QPlainTextEdit#commandBox {
    background-color: #080808;
    color: #10b981;
    font-family: "JetBrains Mono", "Fira Code", "Cascadia Code", "Consolas", monospace;
    font-size: 12px;
    border: 1px solid #202020;
    border-radius: 6px;
    padding: 8px;
}

QPlainTextEdit#commandBox:focus {
    border-color: #4a4a4a;
}

QPlainTextEdit#commandBoxReadOnly {
    background-color: #080808;
    color: #9e9e9e;
    font-family: "JetBrains Mono", "Fira Code", "Cascadia Code", "Consolas", monospace;
    font-size: 12px;
    border: 1px solid #202020;
    border-radius: 6px;
    padding: 8px;
}

/* ── Buttons – base ────────────────────────────────────────────────────── */

QPushButton {
    background-color: #161616;
    color: #ededed;
    border: 1px solid #262626;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 500;
    min-height: 28px;
}

QPushButton:hover {
    background-color: #1f1f1f;
    border-color: #383838;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #111111;
    border-color: #202020;
}

QPushButton:disabled {
    background-color: #121212;
    color: #555555;
    border-color: #202020;
}

/* ── Approve button – emerald accent ───────────────────────────────────── */

QPushButton#approveButton {
    background-color: #10b981;
    color: #ffffff;
    border: 1px solid #10b981;
    border-radius: 6px;
    font-weight: 600;
}

QPushButton#approveButton:hover {
    background-color: #059669;
    border-color: #059669;
    color: #ffffff;
}

QPushButton#approveButton:pressed {
    background-color: #047857;
    border-color: #047857;
}

QPushButton#approveButton:disabled {
    background-color: #1c2b22;
    color: #4e735e;
    border-color: transparent;
}

/* ── Reject button – subtle danger outline ─────────────────────────────── */

QPushButton#rejectButton {
    background-color: #221415;
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.30);
    border-radius: 6px;
}

QPushButton#rejectButton:hover {
    background-color: #2c181a;
    border-color: rgba(239, 68, 68, 0.50);
    color: #fca5a5;
}

QPushButton#rejectButton:pressed {
    background-color: #180f10;
    border-color: rgba(239, 68, 68, 0.30);
}

QPushButton#rejectButton:disabled {
    background-color: #161616;
    color: #555555;
    border-color: #202020;
}

/* ── Warning / danger badge ────────────────────────────────────────────── */

QLabel#warningBadge {
    background-color: rgba(245, 158, 11, 0.12);
    color: #f59e0b;
    border: 1px solid rgba(245, 158, 11, 0.35);
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#dangerBadge {
    background-color: rgba(239, 68, 68, 0.12);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.35);
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

/* ── Approval card (QFrame) ────────────────────────────────────────────── */

QFrame#approvalCard {
    background-color: #121212;
    border: 1px solid #262626;
    border-radius: 8px;
}

QFrame#approvalCardHighRisk {
    background-color: #121212;
    border: 1px solid rgba(245, 158, 11, 0.50);
    border-radius: 8px;
}

QFrame#approvalCardDanger {
    background-color: #121212;
    border: 1px solid rgba(239, 68, 68, 0.50);
    border-radius: 8px;
}

/* ── Collapsible toggle button (Beginner) ──────────────────────────────── */

QToolButton#collapseToggle {
    background-color: transparent;
    color: #9e9e9e;
    border: none;
    font-size: 12px;
    text-align: left;
    padding: 2px 0;
}

QToolButton#collapseToggle:hover {
    color: #ededed;
}

/* ── Separator ─────────────────────────────────────────────────────────── */

QFrame[frameShape="4"],   /* HLine */
QFrame[frameShape="5"] {  /* VLine */
    color: #202020;
}

/* ── Combo boxes ───────────────────────────────────────────────────────── */

QComboBox {
    background-color: #141414;
    color: #ededed;
    border: 1px solid #262626;
    border-radius: 6px;
    padding: 5px 28px 5px 10px;
    min-height: 28px;
}

QComboBox:hover {
    background-color: #1c1c1c;
    border-color: #383838;
    color: #ffffff;
}

QComboBox:focus {
    border-color: #4a4a4a;
}

QComboBox:editable {
    background-color: #141414;
}

QComboBox:editable QLineEdit {
    background-color: transparent;
    border: none;
    color: #ededed;
    padding: 0 4px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 20px;
    border: none;
    background: transparent;
    padding-right: 6px;
}

QComboBox::down-arrow {
    image: url(ui/down_arrow.svg);
    width: 10px;
    height: 6px;
}

QComboBox QAbstractItemView {
    background-color: #141414;
    color: #ededed;
    border: 1px solid #262626;
    border-radius: 6px;
    selection-background-color: #262626;
    selection-color: #ffffff;
    outline: none;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    height: 26px;
    padding: 4px 8px;
    border-radius: 4px;
}

QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:selected {
    background-color: #262626;
    color: #ffffff;
}

/* ── Splitter ──────────────────────────────────────────────────────────── */

QSplitter::handle {
    background-color: #1f1f1f;
    width: 1px;
    height: 1px;
}

QSplitter::handle:hover {
    background-color: #383838;
}

/* ── Status bar ────────────────────────────────────────────────────────── */

QStatusBar {
    background-color: #080808;
    color: #737373;
    font-size: 11px;
    border-top: 1px solid #1c1c1c;
}

/* ── Tooltip ───────────────────────────────────────────────────────────── */

QToolTip {
    background-color: #141414;
    color: #ededed;
    border: 1px solid #262626;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

/* ── Starter Chips ─────────────────────────────────────────────────────── */

QFrame#starterChipsFrame {
    background-color: transparent;
    border: none;
}

QPushButton#starterChip {
    background-color: #141414;
    color: #a1a1a1;
    border: 1px solid #242424;
    border-radius: 14px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 500;
    min-height: 24px;
}

QPushButton#starterChip:hover {
    background-color: #1c1c1c;
    border-color: #383838;
    color: #ffffff;
}

QPushButton#starterChip:pressed {
    background-color: #242424;
    border-color: #4a4a4a;
    color: #ffffff;
}

/* ── Unified Floating Command Bar ──────────────────────────────────────── */

QFrame#commandBar {
    background-color: #121212;
    border: 1px solid #262626;
    border-radius: 10px;
    padding: 6px 10px;
}

QFrame#commandBar[focused="true"] {
    border: 1px solid #4a4a4a;
}

QLineEdit#commandBarInput {
    background-color: transparent;
    color: #ededed;
    border: none;
    font-size: 13px;
    padding: 2px 4px;
    selection-background-color: #383838;
    selection-color: #ffffff;
}

QLineEdit#commandBarInput:disabled {
    color: #555555;
}

QPushButton#commandBarSendBtn {
    background-color: #ededed;
    color: #0a0a0a;
    border: 1px solid #ededed;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 11px;
    font-weight: 600;
    min-height: 22px;
    min-width: 24px;
}

QPushButton#commandBarSendBtn:hover {
    background-color: #ffffff;
    color: #000000;
    border-color: #ffffff;
}

QPushButton#commandBarSendBtn:pressed {
    background-color: #cccccc;
    border-color: #cccccc;
}

QPushButton#commandBarSendBtn:disabled {
    background-color: #1c1c1c;
    color: #555555;
    border-color: transparent;
}

QPushButton#commandBarStopBtn {
    background-color: rgba(239, 68, 68, 0.15);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.35);
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11px;
    font-weight: 500;
    min-height: 22px;
}

QPushButton#commandBarStopBtn:hover {
    background-color: rgba(239, 68, 68, 0.25);
    border-color: rgba(239, 68, 68, 0.55);
    color: #fca5a5;
}

QPushButton#commandBarStopBtn:pressed {
    background-color: rgba(239, 68, 68, 0.35);
}

/* ── Header Minimalist Ghost Controls ──────────────────────────────────── */

QPushButton#headerGhostButton {
    background-color: #141414;
    border: 1px solid #262626;
    border-radius: 6px;
    padding: 2px 10px;
    font-size: 11px;
    color: #a3a3a3;
    font-weight: 500;
    min-height: 28px;
    max-height: 28px;
}

QPushButton#headerGhostButton:hover {
    background-color: #1c1c1c;
    border-color: #383838;
    color: #ffffff;
}

QPushButton#headerGhostButton:checked {
    background-color: #242424;
    border-color: #444444;
    color: #ffffff;
}

QPushButton#headerGhostButton:pressed {
    background-color: #111111;
    color: #ffffff;
}

QComboBox#headerCombo {
    background-color: #141414;
    border: 1px solid #262626;
    border-radius: 6px;
    padding: 2px 24px 2px 10px;
    font-size: 11px;
    font-weight: 500;
    color: #d4d4d4;
    min-height: 28px;
    max-height: 28px;
}

QComboBox#headerCombo:hover {
    background-color: #1c1c1c;
    border-color: #383838;
    color: #ffffff;
}

QComboBox#headerCombo:focus {
    border-color: #4a4a4a;
}

QComboBox#headerCombo::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 16px;
    border: none;
    background: transparent;
    padding-right: 6px;
}

QComboBox#headerCombo::down-arrow {
    image: url(ui/down_arrow.svg);
    width: 10px;
    height: 6px;
}

QComboBox#headerCombo QAbstractItemView {
    background-color: #141414;
    color: #d4d4d4;
    border: 1px solid #262626;
    border-radius: 6px;
    selection-background-color: #242424;
    selection-color: #ffffff;
    outline: none;
    padding: 4px;
}

QComboBox#headerCombo QAbstractItemView::item {
    height: 26px;
    padding: 4px 8px;
    border-radius: 4px;
}

QComboBox#headerCombo QAbstractItemView::item:hover,
QComboBox#headerCombo QAbstractItemView::item:selected {
    background-color: #242424;
    color: #ffffff;
}

/* ── Modal Flat Surface Architecture ───────────────────────────────────── */

QFrame#modalCard {
    background-color: #121212;
    border: 1px solid #202020;
    border-radius: 10px;
}

QPushButton#modalSaveButton {
    background-color: #ededed;
    color: #0a0a0a;
    border: 1px solid #ededed;
    border-radius: 6px;
    font-weight: 500;
    font-size: 12px;
    min-height: 32px;
    max-height: 32px;
    padding: 0 16px;
}

QPushButton#modalSaveButton:hover {
    background-color: #ffffff;
    color: #000000;
    border-color: #ffffff;
}

QPushButton#modalSaveButton:pressed {
    background-color: #cccccc;
    border-color: #cccccc;
}

QPushButton#modalCancelButton {
    background-color: transparent;
    color: #a3a3a3;
    border: 1px solid #262626;
    border-radius: 6px;
    font-weight: 500;
    font-size: 12px;
    min-height: 32px;
    max-height: 32px;
    padding: 0 14px;
}

QPushButton#modalCancelButton:hover {
    background-color: #1c1c1c;
    color: #ffffff;
    border-color: #383838;
}

QPushButton#modalCancelButton:pressed {
    background-color: #111111;
}
